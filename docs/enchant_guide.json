      "type": "entry",
      "name": "千里眼",
      "slot": "防具  ヘルメット",
      "body": [
        "スニーク中、半径50の",
        "敵対Mobが発光する。",
        "",
        "プレイヤーと中立Mobは",
        "対象外。"
      ],
      "back": {
        "id": "toc_gear",
        "label": "« 防具の目次"
      }
    },
    {
      "id": "sky_walk",
