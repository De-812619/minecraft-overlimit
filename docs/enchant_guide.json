      "body": [
        "近接で殴られたとき、",
        "周囲3ブロックの敵を",
        "強くノックバックする。",
        "",
        "再使用まで5秒。",
        "着地できない場所へは",
        "飛ばさない。"
      ],
      "back": {
        "id": "toc_gear",
        "label": "« 防具の目次"
      }
    },
