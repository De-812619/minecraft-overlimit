      "id": "apocalypse",
      "type": "entry",
      "name": "アポカリプス",
      "slot": "武器  剣・斧・槍",
      "body": [
        "直接攻撃すると、",
        "周囲3ブロックの敵が",
        "炎上（3秒）し、",
        "強くノックバックする。",
        "",
        "プレイヤーには当たらない。",
        "毎回発動。"
      ],
      "back": {
        "id": "toc_weapons",
        "label": "« 武器の目次"
      }
    },
